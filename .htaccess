# ---------------------------------------------------------------------------
# GodsForum - Apache configuration
#
# This file is location independent. It works exactly the same whether the
# forum is served from the domain root:
#
#     http://localhost/
#
# or from any subfolder, whatever that folder is named:
#
#     http://localhost/fulldesign-arena-01a0708a-fulldesign/
#     http://localhost/godsforum/
#
# Nothing below hard codes a path, so you never have to edit it after moving
# or renaming the installation directory.
# ---------------------------------------------------------------------------

Options -Indexes

DirectoryIndex index.php index.html

# Make sure Apache is allowed to read the .htaccess rules in subfolders.
# AllowOverride All must be set for this directory in the server config.

# --- Protect sensitive files -----------------------------------------------
# FilesMatch is evaluated per file name, not per URL path, so it keeps working
# no matter which folder the forum lives in.
<FilesMatch "^(\.env|\.htaccess|\.htmlvalidate\.json|\.stylelintrc\.json|\.gitignore|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|lint-php\.cjs|.*\.sql|.*\.md)$">
    Require all denied
</FilesMatch>

# --- Protect private directories -------------------------------------------
# RewriteRule patterns are relative to this directory when RewriteBase is not
# set, so these block includes/, database/, assets/src/ and node_modules/
# regardless of the installation path.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^includes/     - [F,L]
    RewriteRule ^database/     - [F,L]
    RewriteRule ^assets/src/   - [F,L]
    RewriteRule ^node_modules/ - [F,L]
</IfModule>

# Fallback for servers without mod_rewrite: deny the PHP and SQL files that
# must never be requested directly.
<IfModule !mod_rewrite.c>
    <FilesMatch "^(config|db|functions|header|footer|layout)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# --- Static asset caching ---------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif  "access plus 30 days"
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript
</IfModule>

# --- Correct MIME type for the stylesheet -----------------------------------
# Some shared hosts serve .css as text/plain, which browsers then ignore.
<IfModule mod_mime.c>
    AddType text/css .css
</IfModule>
